---
import { NAV_LINKS, SITE } from '@/lib/site-config';
import MobileMenu from './MobileMenu.astro';

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<header
  id="main-header"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 sm:py-5",
    dark ? "bg-[#0E090D]/90 border-b border-[#F1DADA]/10 text-[#F1DADA] backdrop-blur-md" : "bg-white/90 border-b border-[#F0DEE4] text-[#0E090D] backdrop-blur-md"
  ]}
>
  <div class="container-wide flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="inline-flex items-center gap-2 group py-1" aria-label="SimbNext Home">
      <img
        src={dark ? "/simbnext-logo-dark.svg" : "/simbnext-logo.svg"}
        alt="SimbNext"
        width="160"
        height="32"
        class="h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-[14px] font-medium">
      {NAV_LINKS.map((link) => (
        link.children ? (
          <div class="relative group/nav">
            <button
              type="button"
              class:list={[
                "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg transition-colors cursor-pointer",
                dark ? "text-[#F1DADA]/80 hover:text-white hover:bg-white/5" : "text-[#3A2A33] hover:text-[#FB4566] hover:bg-[#FFF2F5]"
              ]}
            >
              <span>{link.label}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 opacity-60 transition-transform group-hover/nav:rotate-180">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-2 pointer-events-none group-hover/nav:opacity-100 group-hover/nav:translate-y-0 group-hover/nav:pointer-events-auto transition-all duration-200 z-50">
              <div class="w-80 rounded-2xl bg-white border border-[#F0DEE4] shadow-xl p-3 grid gap-1 text-[#0E090D]">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="p-2.5 rounded-xl hover:bg-[#FFF2F5] transition-colors flex flex-col text-left group/item"
                  >
                    <span class="text-sm font-semibold text-[#0E090D] group-hover/item:text-[#FB4566] transition-colors flex items-center justify-between">
                      {child.label}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-x-1 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all text-[#FB4566]">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                      </svg>
                    </span>
                    <span class="text-xs text-[#7A636E] mt-0.5 leading-snug">
                      {child.description}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class:list={[
              "px-3 py-2 rounded-lg transition-colors",
              dark ? "text-[#F1DADA]/80 hover:text-white hover:bg-white/5" : "text-[#3A2A33] hover:text-[#FB4566] hover:bg-[#FFF2F5]"
            ]}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <a
        href="/contact"
        class:list={[
          "inline-flex h-10 xl:h-11 items-center justify-center gap-2 rounded-full px-5 text-sm font-bold shadow-xs transition-all hover:scale-[1.02] active:scale-[0.98]",
          dark ? "bg-[#E11D48] text-white hover:bg-[#BE123C]" : "bg-[#E11D48] text-white hover:bg-[#BE123C]"
        ]}
      >
        <span>Schedule a Consultation</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <div class="lg:hidden flex items-center">
      <button
        id="mobile-menu-open"
        type="button"
        class:list={[
          "inline-flex h-10 w-10 items-center justify-center rounded-xl border transition-colors",
          dark ? "border-white/20 text-white hover:bg-white/10" : "border-[#F0DEE4] text-[#0E090D] hover:bg-[#FFF2F5]"
        ]}
        aria-label="Open navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-menu-drawer');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  function openMenu() {
    drawer?.classList.remove('translate-x-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.classList.add('overflow-hidden');
  }

  function closeMenu() {
    drawer?.classList.add('translate-x-full');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    document.body.classList.remove('overflow-hidden');
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
</script>
