---
import { PROCESS } from '@/lib/content';
---

<section class="py-24 md:py-32 bg-[#FCF6F8] border-b border-[#F0DEE4]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Operating Model</span>
      </div>
      <h2 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        From discovery consultation to live operations in days.
      </h2>
      <p class="mt-4 body-lg text-[#3A2A33] [text-wrap:balance]">
        A structured, disciplined onboarding flow designed to deliver immediate operational relief and revenue acceleration.
      </p>
    </div>

    <!-- 3-Step Cards -->
    <div class="grid gap-8 md:grid-cols-3">
      {PROCESS.map((p) => (
        <div class="card-synthesia p-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-extrabold font-mono text-[#BE123C]">
                {p.step}
              </span>
              <span class="chip-synthesia">Stage {p.step}</span>
            </div>

            <h3 class="headline-sm text-[#0E090D]">
              {p.title}
            </h3>

            <p class="mt-3 text-sm text-[#7A636E] leading-relaxed">
              {p.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#F0DEE4]">
            <div class="label-sm text-[#7A636E] mb-2.5">
              Deliverables:
            </div>
            <ul class="space-y-1.5 text-xs text-[#0E090D] font-medium">
              {p.deliverables.map((d) => (
                <li class="flex items-start gap-2">
                  <span class="text-[#BE123C] font-bold">✓</span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Operating Model Link -->
    <div class="mt-12 text-center">
      <a href="/how-we-work" class="inline-flex items-center gap-2 text-sm font-bold text-[#BE123C] hover:underline">
        <span>Explore our complete SLA governance & operating model</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
