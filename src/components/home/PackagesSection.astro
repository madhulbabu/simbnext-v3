---
import { PACKAGES } from '@/lib/content';
---

<section id="packages" class="py-24 md:py-32 bg-[#FFFFFF] border-b border-[#F0DEE4]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Engagement Models</span>
      </div>
      <h2 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        Predictable monthly retainers.<br class="hidden sm:inline" /> Explicit SLA governance.
      </h2>
      <p class="mt-4 body-lg text-[#3A2A33] [text-wrap:balance]">
        All partnerships operate as predictable monthly retainers governed by clear Service Level Agreements. Custom proposals provided following your initial discovery consultation.
      </p>
    </div>

    <!-- 3 Tier Cards -->
    <div class="grid gap-8 lg:grid-cols-3 items-stretch">
      {PACKAGES.map((pkg) => (
        pkg.featured ? (
          <!-- Featured Tier: Growth Partner (Deep Velvet Noir Card with Raspberry Coral Glow) -->
          <div class="relative rounded-3xl bg-[#0E090D] text-[#F1DADA] p-7 xl:p-9 shadow-2xl flex flex-col justify-between border border-[#FB4566]/40 hover:scale-[1.01] transition-transform">
            <div class="absolute -top-3.5 right-6">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E11D48] px-3.5 py-1 text-xs font-mono font-bold uppercase tracking-wider text-white shadow-md">
                ★ {pkg.badge}
              </span>
            </div>

            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-[#FB4566] font-bold">
                {pkg.tier}
              </span>
              <h3 class="headline-md text-white mt-1">
                {pkg.name}
              </h3>
              
              <div class="mt-3 inline-flex items-center gap-2 text-xs font-bold text-[#F1DADA] bg-white/10 px-3 py-1 rounded-full border border-white/15">
                <span>🛡️ {pkg.desksIncluded}</span>
              </div>

              <p class="mt-4 text-sm text-[#F1DADA]/80 leading-relaxed">
                {pkg.recommendedFor}
              </p>

              <div class="my-6 border-t border-white/15"></div>

              <div class="space-y-3">
                <div class="text-xs font-mono uppercase tracking-wider text-[#FB4566] font-bold">
                  Included Coverage:
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-[#F1DADA]">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#FB4566] font-bold shrink-0">✓</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-white/15">
              <a href="/contact" class="btn-white-pill w-full text-center">
                <span>{pkg.ctaText}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        ) : (
          <!-- Standard Tiers: Essential & Complete Partner -->
          <div class="card-synthesia p-7 xl:p-9 flex flex-col justify-between">
            <div>
              <span class="label-sm text-[#BE123C]">
                {pkg.tier}
              </span>
              <h3 class="headline-md text-[#0E090D] mt-1">
                {pkg.name}
              </h3>

              <div class="mt-3 inline-flex items-center gap-2 text-xs font-bold text-[#BE123C] bg-[#FFF2F5] px-3 py-1 rounded-full border border-[#F0DEE4]">
                <span>🛡️ {pkg.desksIncluded}</span>
              </div>

              <p class="mt-4 text-sm text-[#7A636E] leading-relaxed">
                {pkg.recommendedFor}
              </p>

              <div class="my-6 border-t border-[#F0DEE4]"></div>

              <div class="space-y-3">
                <div class="label-sm text-[#7A636E]">
                  Included Coverage:
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-[#3A2A33]">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#BE123C] font-bold shrink-0">✓</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-[#F0DEE4]">
              <a href="/contact" class="button-primary w-full text-center">
                <span>{pkg.ctaText}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        )
      ))}
    </div>

  </div>
</section>
