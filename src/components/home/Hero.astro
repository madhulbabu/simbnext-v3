---
import { SITE } from '@/lib/site-config';
---

<section class="relative overflow-hidden bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] pt-36 md:pt-44 pb-20 md:pb-28 border-b border-[#F0DEE4]">
  <!-- Soft ambient radial raspberry glow -->
  <div class="pointer-events-none absolute top-10 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-[#FB4566]/10 via-[#FB4566]/4 to-transparent rounded-full blur-[120px]" aria-hidden="true"></div>

  <div class="container-wide relative z-10 text-center">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-white text-[#BE123C] border border-[#F0DEE4] shadow-xs mb-6">
      <span class="h-2 w-2 rounded-full bg-[#98FE7F] animate-pulse"></span>
      <span>Enquiry to Customer, Simplified · 3.2s Speed-to-Lead</span>
    </div>

    <!-- Centered Headline -->
    <h1 class="headline-display text-[#0E090D] max-w-4xl mx-auto tracking-tight [text-wrap:balance]">
      The Outsourced
      <span class="inline-block bg-[#FFF2F5] text-[#BE123C] px-3.5 py-1 rounded-2xl border border-[#F0DEE4] mx-1 shadow-xs">
        Digital Department
      </span>
      for Established Teams
    </h1>

    <!-- Centered Subheadline -->
    <p class="body-lg text-[#3A2A33] max-w-2xl mx-auto mt-6 leading-relaxed [text-wrap:balance]">
      We manage your customer acquisition, 24/7 AI lead operations, and web infrastructure under guaranteed monthly SLAs—with zero agency chaos.
    </p>

    <!-- Review / Social Proof Strip -->
    <div class="mt-6 flex items-center justify-center gap-3 text-xs text-[#7A636E] font-mono">
      <div class="flex text-amber-400 text-sm">
        ★★★★★
      </div>
      <span class="font-bold text-[#0E090D]">4.9/5 Rating</span>
      <span>•</span>
      <span>100% Senior Accountability</span>
      <span>•</span>
      <span class="text-[#FB4566] font-bold">99.8% SLA Compliance</span>
    </div>

    <!-- Centered CTA Buttons -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 min-h-[48px]">
      <a href="/contact" class="button-primary text-center">
        <span>Schedule a Consultation</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
      <a href="#desks" class="button-secondary text-center">
        <span>Explore The 6 Desks</span>
      </a>
    </div>

    <!-- Centered Hero Visual Dashboard Frame -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-3xl border border-[#F0DEE4] bg-white p-3 sm:p-5 shadow-[0_20px_60px_rgba(251,69,102,0.08)] overflow-hidden">
        
        <!-- Browser / Command Top Header Bar -->
        <div class="flex items-center justify-between px-3 py-2.5 bg-[#FCF6F8] rounded-2xl border border-[#F0DEE4] mb-4">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="h-3 w-3 rounded-full bg-[#FB4566]"></span>
              <span class="h-3 w-3 rounded-full bg-amber-400"></span>
              <span class="h-3 w-3 rounded-full bg-[#98FE7F]"></span>
            </div>
            <span class="text-xs font-mono text-[#7A636E] ml-2 hidden sm:inline">simbnext.com/command-center</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#98FE7F] animate-pulse"></span>
            <span class="text-[11px] font-mono font-bold text-[#BE123C] bg-[#FFF2F5] px-2.5 py-0.5 rounded-full border border-[#F0DEE4]">
              All 6 Desks Active · Guaranteed SLA
            </span>
          </div>
        </div>

        <!-- 6-Desk Interactive Preview Grid inside Dashboard -->
        <div class="grid gap-3 sm:grid-cols-3 text-left">
          
          <!-- Desk 1: Customer Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">01 · Customer Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#FFF2F5] text-[#BE123C] font-bold">Live Triage</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">24/7 AI Lead Agent</div>
            <p class="text-xs text-[#7A636E] mt-1">Instant WhatsApp triage & CRM booking</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Latency</span>
              <span class="text-[#BE123C] font-bold">3.2s SLA</span>
            </div>
          </div>

          <!-- Desk 2: Growth Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">02 · Growth Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#FFF2F5] text-[#BE123C] font-bold">Inbound Ads</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">Google & Meta Ads</div>
            <p class="text-xs text-[#7A636E] mt-1">High-intent search & creative rotation</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Consultations</span>
              <span class="text-emerald-700 font-bold">+180% Lift</span>
            </div>
          </div>

          <!-- Desk 3: Strategy Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">03 · Strategy Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 font-bold">Executive</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">Roadmaps & OKRs</div>
            <p class="text-xs text-[#7A636E] mt-1">Unit economics & monthly MBR reviews</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Delivery</span>
              <span class="text-purple-800 font-bold">3rd Business Day</span>
            </div>
          </div>

          <!-- Desk 4: Content Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">04 · Content Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 font-bold">Media</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">Short-Form Reels</div>
            <p class="text-xs text-[#7A636E] mt-1">8x video assets & authority distribution</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Turnaround</span>
              <span class="text-amber-800 font-bold">48h SLA</span>
            </div>
          </div>

          <!-- Desk 5: Automation Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">05 · Automation Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">Workflows</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">Operational Efficiency</div>
            <p class="text-xs text-[#7A636E] mt-1">API routing & paperwork elimination</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Time Saved</span>
              <span class="text-emerald-700 font-bold">40+ hrs/mo</span>
            </div>
          </div>

          <!-- Desk 6: Digital Desk -->
          <div class="p-4 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C]">06 · Digital Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#FFF2F5] text-[#BE123C] font-bold">Web Edge</span>
            </div>
            <div class="text-sm font-bold text-[#0E090D]">Next.js Infrastructure</div>
            <p class="text-xs text-[#7A636E] mt-1">1.2s Core Web Vitals & managed hosting</p>
            <div class="mt-3 pt-2 border-t border-[#F0DEE4] flex items-center justify-between text-xs font-mono">
              <span class="text-[#7A636E]">Uptime</span>
              <span class="text-[#BE123C] font-bold">99.8% SLA</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
