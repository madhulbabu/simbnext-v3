---
import { FAQS } from '@/lib/content';
---

<section id="faq" class="py-24 md:py-32 bg-[#FFFFFF] border-b border-[#F0DEE4]">
  <div class="container-tight">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Frequently Answered</span>
      </div>
      <h2 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        Everything you need to know.
      </h2>
      <p class="mt-4 body-lg text-[#3A2A33] [text-wrap:balance]">
        Transparent answers about our engagement models, SLAs, and operating standards.
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {FAQS.map((faq) => (
        <div class="faq-item rounded-2xl border border-[#F0DEE4] bg-[#FCF6F8] overflow-hidden transition-all">
          <button
            type="button"
            class="faq-trigger w-full p-6 text-left flex items-center justify-between gap-4 font-bold text-[#0E090D] hover:text-[#FB4566] transition-colors cursor-pointer"
          >
            <span class="text-base sm:text-lg">{faq.q}</span>
            <span class="faq-icon h-7 w-7 rounded-full bg-white border border-[#F0DEE4] flex items-center justify-center text-[#FB4566] shrink-0 font-mono text-base transition-transform">
              +
            </span>
          </button>
          <div class="faq-content hidden px-6 pb-6 text-sm sm:text-base text-[#7A636E] leading-relaxed border-t border-[#F0DEE4]/60 pt-4">
            {faq.a}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const items = document.querySelectorAll('.faq-item');

  items.forEach((item) => {
    const trigger = item.querySelector('.faq-trigger');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');

    trigger?.addEventListener('click', () => {
      const isOpen = !content?.classList.contains('hidden');

      items.forEach((otherItem) => {
        otherItem.querySelector('.faq-content')?.classList.add('hidden');
        const otherIcon = otherItem.querySelector('.faq-icon');
        if (otherIcon) otherIcon.textContent = '+';
        otherItem.classList.remove('border-[#FB4566]/40', 'bg-white', 'shadow-xs');
      });

      if (!isOpen && content) {
        content.classList.remove('hidden');
        if (icon) icon.textContent = '−';
        item.classList.add('border-[#FB4566]/40', 'bg-white', 'shadow-xs');
      }
    });
  });
</script>
