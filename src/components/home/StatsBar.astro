---
const STATS = [
  { value: '₹2.5L+', label: 'Monthly Overhead Saved vs Fragmented Agencies' },
  { value: '3.2 sec', label: 'Speed-to-Lead WhatsApp Response Latency', highlight: true },
  { value: '99.8%', label: 'Delivery SLA Compliance Across All Desks' },
  { value: '100%', label: 'Senior Operations Leadership (Zero Junior Hand-offs)' },
];
---

<div class="bg-white text-[#0E090D] py-12 border-b border-[#F0DEE4]">
  <div class="container-wide">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {STATS.map((s) => (
        <div class="p-6 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4] hover:border-[#FB4566]/30 transition-colors">
          <div class:list={[
            "text-2xl sm:text-3xl lg:text-4xl font-extrabold font-mono tracking-tight",
            s.highlight ? "text-[#BE123C]" : "text-[#0E090D]"
          ]}>
            {s.value}
          </div>
          <div class="text-xs sm:text-sm text-[#7A636E] mt-2 font-medium leading-snug">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
