---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site-config';
---

<BaseLayout title="Terms of Service | SimbNext" description="Terms of service governing SimbNext digital operations retainers and SLAs.">
  <!-- Light Header Section -->
  <div class="pt-36 pb-16 bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] border-b border-[#F0DEE4]">
    <div class="container-wide max-w-3xl space-y-3">
      <span class="chip-synthesia">Governance & Compliance</span>
      <h1 class="headline-lg text-[#0E090D]">Terms of Service</h1>
      <p class="text-xs text-[#7A636E] font-mono">Last updated: January 2026</p>
    </div>
  </div>

  <div class="py-16 bg-[#FFFFFF]">
    <div class="container-wide max-w-3xl prose prose-neutral text-sm space-y-6 text-[#3A2A33]">
      <p>
        These Terms of Service govern your engagement with {SITE.legalName} for outsourced digital department retainers and AI operations services.
      </p>

      <h2 class="text-lg font-bold text-[#0E090D] mt-6">1. Scope of Engagement</h2>
      <p>
        Services are structured through modular monthly Desks (Strategy, Growth, Content, Customer, Automation, Digital) operating under agreed Service Level Agreements (SLAs).
      </p>

      <h2 class="text-lg font-bold text-[#0E090D] mt-6">2. Retainers & Billing</h2>
      <p>
        Engagements operate on predictable monthly retainers billed at the start of each service cycle. There are no hidden fees or unexpected task surcharges.
      </p>

      <h2 class="text-lg font-bold text-[#0E090D] mt-6">3. Cancellation & Notice</h2>
      <p>
        Partnerships are month-to-month and may be cancelled by either party with a simple 30-day written notice, following completion of any initial onboarding sprint.
      </p>

      <h2 class="text-lg font-bold text-[#0E090D] mt-6">4. Intellectual Property</h2>
      <p>
        All custom creative assets, website code, video reels, and trained knowledge base configurations created specifically for your business belong 100% to you.
      </p>
    </div>
  </div>
</BaseLayout>
