---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CASE_STUDIES } from '@/lib/content';
---

<BaseLayout
  title="Case Studies & Client Outcomes | SimbNext"
  description="Explore real outcomes delivered for healthcare clinics, luxury interior studios, real estate firms, and B2B enterprises."
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] border-b border-[#F0DEE4]">
    <div class="container-wide max-w-3xl space-y-4 text-center mx-auto">
      <span class="chip-synthesia">Proven Outcomes</span>
      <h1 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        Case Studies & Verified Impact
      </h1>
      <p class="body-lg text-[#3A2A33] [text-wrap:balance]">
        Measurable results from owner-led companies who traded fragmented agency chaos for disciplined digital operations.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide max-w-4xl space-y-10">
      {CASE_STUDIES.map((c) => (
        <div class="card-synthesia p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 hover:scale-[1.01] transition-transform">
          <div class="space-y-3 max-w-lg">
            <div class="flex items-center gap-3">
              <span class="chip-synthesia">{c.sector}</span>
              <span class="text-xs font-mono text-[#7A636E]">{c.location}</span>
            </div>
            <h2 class="headline-sm text-[#0E090D]">
              {c.client}
            </h2>
            <p class="text-sm text-[#3A2A33] leading-relaxed italic">
              "{c.quote}"
            </p>
            <div class="text-xs text-[#7A636E] font-semibold pt-1">
              {c.author} · {c.role}
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-[#FFF2F5] border border-[#F0DEE4] text-center shrink-0 w-full md:w-48 shadow-xs">
            <div class="text-3xl font-extrabold font-mono text-[#FB4566]">
              {c.stat}
            </div>
            <div class="text-xs font-semibold text-[#E11D48] mt-1">
              {c.statLabel}
            </div>
          </div>
        </div>
      ))}

      <!-- CTA -->
      <div class="pt-10 text-center">
        <a href="/contact" class="button-primary">
          <span>Schedule a Consultation</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
