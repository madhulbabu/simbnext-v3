---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PROCESS } from '@/lib/content';
---

<BaseLayout
  title="Operating Model & SLAs — How We Work | SimbNext"
  description="From discovery consultation to 5-day setup sprint and predictable monthly Desk operations backed by strict Service Level Agreements."
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] border-b border-[#F0DEE4]">
    <div class="container-wide max-w-3xl space-y-4 text-center mx-auto">
      <span class="chip-synthesia">Operating Model & Governance</span>
      <h1 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        From Discovery Consultation to Live Operations in Days
      </h1>
      <p class="body-lg text-[#3A2A33] [text-wrap:balance]">
        A disciplined, senior-led onboarding flow: evaluate your operations, deploy active Desks in 5 days, and operate under strict Service Level Agreements.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide max-w-4xl space-y-12">
      <!-- 3 Steps -->
      {PROCESS.map((p) => (
        <div class="card-synthesia p-8 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] items-center">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl font-extrabold font-mono text-[#FB4566]">
                {p.step}
              </span>
              <span class="chip-synthesia">Stage {p.step}</span>
            </div>
            <h2 class="headline-md text-[#0E090D]">
              {p.title}
            </h2>
            <p class="mt-3 text-sm text-[#7A636E] leading-relaxed">
              {p.description}
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#FCF6F8] border border-[#F0DEE4]">
            <div class="label-sm text-[#7A636E] mb-2.5">
              Stage Deliverables:
            </div>
            <ul class="space-y-2 text-xs font-semibold text-[#0E090D]">
              {p.deliverables.map((d) => (
                <li class="flex items-start gap-2">
                  <span class="text-[#FB4566] font-bold">✓</span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <!-- SLA Commitments Box (Blush Ice & Raspberry Coral) -->
      <div class="p-8 rounded-3xl bg-[#FFF2F5] border border-[#F0DEE4] space-y-6 shadow-xs">
        <span class="chip-synthesia">SLA Guarantees</span>
        <h2 class="headline-md text-[#0E090D]">
          Our Explicit Service Level Agreements
        </h2>
        <div class="grid gap-4 sm:grid-cols-3 text-sm">
          <div class="p-5 rounded-2xl bg-white border border-[#F0DEE4] shadow-xs">
            <div class="text-[#FB4566] font-bold text-base mb-1">3rd Business Day</div>
            <div class="text-xs text-[#7A636E]">Monthly Scorecard & MBR Delivery</div>
          </div>
          <div class="p-5 rounded-2xl bg-white border border-[#F0DEE4] shadow-xs">
            <div class="text-[#FB4566] font-bold text-base mb-1">3.2 Seconds</div>
            <div class="text-xs text-[#7A636E]">Average Speed-to-Lead Response SLA</div>
          </div>
          <div class="p-5 rounded-2xl bg-white border border-[#F0DEE4] shadow-xs">
            <div class="text-[#FB4566] font-bold text-base mb-1">99.8% Guaranteed</div>
            <div class="text-xs text-[#7A636E]">Web Infrastructure & Edge Uptime</div>
          </div>
        </div>
      </div>

      <!-- Action -->
      <div class="text-center pt-6">
        <a href="/contact" class="button-primary">
          <span>Schedule a Consultation</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
