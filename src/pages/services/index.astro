---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DESKS } from '@/lib/content';
---

<BaseLayout title="The 6 Desks — Complete Functional Architecture" description="Explore our 6 dedicated digital operations Desks: Strategy, Growth, Content, Customer, Automation, and Digital.">
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] border-b border-[#F0DEE4]">
    <div class="container-wide text-center max-w-3xl mx-auto space-y-4">
      <span class="chip-synthesia">
        Functional Specifications
      </span>
      <h1 class="headline-lg text-[#0E090D] [text-wrap:balance]">
        The 6 Dedicated Desks
      </h1>
      <p class="body-lg text-[#3A2A33] [text-wrap:balance]">
        Every critical recurring digital function managed under strict Service Level Agreements by a senior operations team.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {DESKS.map((desk) => (
          <div class="card-synthesia p-8 flex flex-col justify-between hover:scale-[1.01] transition-transform">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono font-bold text-[#FB4566]">DESK {desk.index}</span>
                <span class="chip-synthesia">{desk.category}</span>
              </div>

              <h2 class="headline-sm text-[#0E090D] mt-2">
                {desk.name}
              </h2>

              <p class="mt-2 text-xs font-semibold text-[#FB4566]">
                {desk.tagline}
              </p>

              <p class="mt-3 text-sm text-[#7A636E] leading-relaxed">
                {desk.description}
              </p>

              <div class="mt-6 pt-4 border-t border-[#F0DEE4]">
                <div class="label-sm text-[#7A636E] mb-2">Key Deliverables:</div>
                <ul class="space-y-1.5 text-xs text-[#0E090D]">
                  {desk.deliverables.map((d) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#FB4566] font-bold">✓</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-[#F0DEE4] flex items-center justify-between">
              <a
                href={`/services/${desk.slug}`}
                class="button-primary w-full text-center text-xs"
              >
                <span>View Full Specifications</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
