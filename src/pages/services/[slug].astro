---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DESKS } from '@/lib/content';

export function getStaticPaths() {
  return DESKS.map((desk) => ({
    params: { slug: desk.slug },
    props: { desk },
  }));
}

const { desk } = Astro.props;
---

<BaseLayout
  title={`${desk.name} — ${desk.category}`}
  description={desk.description}
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#FFF2F5] via-[#FCF6F8] to-white text-[#0E090D] border-b border-[#F0DEE4]">
    <div class="container-wide">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-3">
          <span class="chip-synthesia">{desk.category}</span>
          <span class="text-xs font-mono text-[#7A636E]">Desk {desk.index} of 06</span>
        </div>
        <h1 class="headline-lg text-[#0E090D] [text-wrap:balance]">
          {desk.name}
        </h1>
        <p class="text-lg text-[#FB4566] font-semibold">
          {desk.tagline}
        </p>
        <p class="body-md text-[#3A2A33] leading-relaxed [text-wrap:balance]">
          {desk.description}
        </p>

        <div class="pt-4 flex items-center gap-4">
          <a href="/contact" class="button-primary">
            <span>Request Proposal with {desk.name}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide">
      <div class="grid gap-14 lg:grid-cols-[1.2fr_0.8fr] items-start">
        
        <!-- Left Column: Deliverables & Outcomes -->
        <div class="space-y-10">
          <!-- SLA Guarantee Box (Blush Ice Tint) -->
          <div class="rounded-2xl bg-[#FFF2F5] p-6 border border-[#F0DEE4]">
            <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#FB4566] uppercase tracking-wider mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              Service Level Agreement (SLA) Commitment
            </div>
            <p class="text-base font-semibold text-[#0E090D]">
              {desk.sla}
            </p>
          </div>

          <!-- Included Deliverables -->
          <div>
            <h2 class="headline-md text-[#0E090D] mb-5">
              Included Monthly Deliverables & Capacity
            </h2>
            <div class="grid gap-3">
              {desk.deliverables.map((item) => (
                <div class="p-5 rounded-2xl border border-[#F0DEE4] bg-[#FCF6F8] flex items-start gap-3">
                  <span class="h-2 w-2 rounded-full bg-[#FB4566] mt-2 shrink-0"></span>
                  <span class="text-sm font-medium text-[#0E090D]">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Business Outcomes -->
          <div>
            <h2 class="headline-md text-[#0E090D] mb-5">
              Business Outcomes & Impact
            </h2>
            <div class="p-6 rounded-2xl border border-[#F0DEE4] bg-white space-y-3 shadow-xs">
              {desk.outcomes.map((outcome) => (
                <div class="flex items-start gap-3 text-sm text-[#3A2A33]">
                  <span class="text-[#FB4566] font-bold">✓</span>
                  <span>{outcome}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Column: Desk Explorer Sidebar -->
        <div class="space-y-6 lg:sticky lg:top-28">
          <div class="card-synthesia p-6">
            <h3 class="headline-sm text-[#0E090D] mb-4">
              The 6 Desks Architecture
            </h3>
            <div class="space-y-2">
              {DESKS.map((d) => (
                <a
                  href={`/services/${d.slug}`}
                  class:list={[
                    "p-3 rounded-xl flex items-center justify-between text-xs font-semibold transition-colors",
                    d.slug === desk.slug
                      ? "bg-[#FFF2F5] text-[#FB4566] border border-[#F0DEE4]"
                      : "text-[#3A2A33] hover:bg-[#FCF6F8]"
                  ]}
                >
                  <span>{d.name}</span>
                  <span class="text-[10px] font-mono text-[#7A636E]">{d.index}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="rounded-3xl bg-[#FFF2F5] border border-[#F0DEE4] p-6 space-y-4">
            <h4 class="text-base font-bold text-[#0E090D]">Ready to activate {desk.name}?</h4>
            <p class="text-xs text-[#3A2A33] leading-relaxed">
              Book a discovery consultation. We will analyze your operations and provide a tailored SLA proposal.
            </p>
            <a href="/contact" class="button-primary w-full text-center text-xs">
              <span>Schedule a Consultation</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
